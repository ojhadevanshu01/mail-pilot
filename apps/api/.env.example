
# MailPilot environment template
# Safe placeholders only. Never commit real secrets.

# Database — Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Redis / BullMQ
REDIS_URL=redis://HOST:6379

# API
PORT=3000
CORS_ORIGIN=http://localhost:3001
API_RATE_LIMIT=300

# Queue reconciliation and worker
RECONCILE_INTERVAL_MS=60000
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Ethereal email — development/testing only
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=your_ethereal_username
ETHEREAL_PASSWORD=your_ethereal_password

# Encryption key for stored sender credentials
# Generate a new 32-byte key in hex for a fresh setup.
# Do not replace an existing production key without a migration plan.
SENDER_CREDENTIALS_KEY=replace_with_64_hex_characters

# Application URL
WEB_URL=http://localhost:3001

# SMTP used for authentication emails
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=your_auth_email@gmail.com
AUTH_SMTP_PASS=your_gmail_app_password
AUTH_MAIL_FROM=MailPilot

# Set production URLs and credentials in the hosting provider's
# environment settings, not in this example file.
